{
  "name": "@jhonny_bcastro/document-editor",
  "version": "0.1.0-rc.4",
  "author": "Jhonny B. Castro",
  "license": "MIT",
  "description": "Pagination extension for Tiptap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JhonnyBCastro/document-editor.git"
  },
  "bugs": {
    "url": "https://github.com/JhonnyBCastro/document-editor/issues"
  },
  "homepage": "https://github.com/JhonnyBCastro/document-editor#readme",
  "keywords": [
    "tiptap",
    "prosemirror",
    "pagination",
    "print",
    "editor"
  ],
  "type": "module",
  "main": "dist/pagination.umd.js",
  "module": "dist/pagination.es.js",
  "types": "dist/index.d.ts",
  "style": "dist/document-editor.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pagination.es.js",
      "require": "./dist/pagination.umd.js"
    },
    "./style.css": "./dist/document-editor.css",
    "./presentation": {
      "types": "./dist/presentation/presentation/index.d.ts",
      "import": "./dist/presentation/index.es.js",
      "require": "./dist/presentation/index.umd.js"
    },
    "./presentation.css": "./dist/presentation/presentation.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build -c vite.config.lib.ts && vite build -c vite.config.presentation.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/pagination-stress.spec.cjs"
  },
  "devDependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/starter-kit": "^3.31.4",
    "jsdom": "^30.1.1",
    "puppeteer": "^25.12.0",
    "puppeteer-core": "^23.6.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.2.1",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.0.0 || ^3.0.0",
    "@tiptap/pm": "^2.0.0 || ^3.0.0"
  }
}
